#!/usr/bin/env bash
# Install the development dependencies, including the exact hassil /
# home-assistant-intents versions pinned by the installed Home Assistant
# release (the conversation component imports them at collection time).
set -euo pipefail

cd "$(dirname "$0")/.."

PYTHON="${PYTHON:-python}"

"$PYTHON" -m pip install --upgrade pip
"$PYTHON" -m pip install -r requirements.txt

# Read the manifest by path: importing the component itself already needs hassil.
conversation_requirements=$("$PYTHON" - <<'EOF'
import json
from pathlib import Path

import homeassistant

manifest = Path(homeassistant.__file__).parent / "components" / "conversation" / "manifest.json"
print(" ".join(json.loads(manifest.read_text())["requirements"]))
EOF
)

# shellcheck disable=SC2086
"$PYTHON" -m pip install $conversation_requirements
